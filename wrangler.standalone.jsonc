{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "art-homey",
  "main": "worker.mjs",
  "compatibility_date": "2026-05-15",
  "assets": {"directory": "./docs", "binding": "ASSETS", "html_handling": "none", "run_worker_first": ["/", "/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "art-homey", "database_id": "00000000-0000-4000-8000-000000000000", "migrations_dir": "drizzle"}],
  "triggers": {"crons": ["* * * * *"]},
  "observability": {"enabled": false}
}
